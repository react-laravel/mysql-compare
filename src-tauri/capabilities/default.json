{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MySQL Compare desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "allow-commands",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message"
  ]
}
